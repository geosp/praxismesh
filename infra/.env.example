# PraxisMesh local stack configuration. Copy to infra/.env (git-ignored) and edit:
#
#     cp infra/.env.example infra/.env
#
# The values below are placeholders for a local, single-user stack bound to
# 127.0.0.1. Change the passwords before using the stack for anything else.
# Database passwords are applied only when the database volume is first
# created; after changing them, run `make reset` (this deletes all data).
#
# Syntax: plain KEY=value lines with the names below. Values may use only
# A-Z a-z 0-9 . _ : / @ % + , = - (Docker Compose, uv and a shell must all read
# them the same way). `make up` names any line that breaks this.

# Compose project name (lowercase letters, digits, '_' or '-'). Give each
# checkout that runs its own stack a different name (and different ports), or
# `make reset` in one deletes the other's data. Only this file counts: make
# ignores a COMPOSE_PROJECT_NAME set in your shell. Each key may appear once.
COMPOSE_PROJECT_NAME=praxismesh

# Database (ParadeDB, one server, three databases)
POSTGRES_PASSWORD=change-me-postgres
TEMPORAL_DB_PASSWORD=change-me-temporal
APP_DB_PASSWORD=change-me-app
DB_PORT=5432

# Temporal
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
TEMPORAL_NAMESPACE=default
# <number><s|m|h|d>, at least one day; `make up` applies a changed value.
TEMPORAL_RETENTION=72h

# Object storage (SeaweedFS, S3-compatible)
S3_PORT=8333
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key
# Bucket the BlobStore uses; created on first use.
S3_BUCKET=praxismesh

# Model endpoint (vLLM, external). Base URL without /v1, for example
# http://<spark-host>:8000. Leave empty to skip the model tests.
VLLM_BASE_URL=
# Served model name; must not contain "/".
VLLM_MODEL=spark
# Empty when the endpoint needs no key.
VLLM_API_KEY=

# Database URL for the sample MCP server (sample_mcp/), passed only to MCP servers
# that a template grants it to. Optional until the workers run (Phase 1 PR 2).
PRAXIS_SAMPLE_DB_URL=

# OpenTelemetry: OTLP/HTTP endpoint for traces, for example http://127.0.0.1:4318.
# Optional; when empty, traces are not exported anywhere.
OTEL_EXPORTER_OTLP_ENDPOINT=
